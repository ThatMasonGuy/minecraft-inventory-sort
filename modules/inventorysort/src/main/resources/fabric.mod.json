{
  "schemaVersion": 1,
  "id": "inventorysort",
  "version": "${version}",
  "name": "Inventory Sort",
  "description": "Quickly sort Minecraft inventories and containers into a clean, predictable order.",
  "authors": ["Tempest Studios"],
  "contact": {},
  "license": "LGPL-3.0-only",
  "icon": "assets/inventory-sort/invsort.jpg",
  "environment": "client",
  "entrypoints": {
    "client": ["tempeststudios.inventorysort.InventorySortClient"]
  },
  "mixins": ["inventorysort.mixins.json"],
  "depends": {
    "inventorysort_core": ">=${version}",
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}"
  }
}
