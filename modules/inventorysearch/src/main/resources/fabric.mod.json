{
  "schemaVersion": 1,
  "id": "inventorysearch",
  "version": "${version}",
  "name": "Inventory Search",
  "description": "Find items across your inventory and known storage locations with a clean in-game search.",
  "authors": ["Tempest Studios"],
  "contact": {},
  "license": "LGPL-3.0-only",
  "icon": "assets/inventory-sort/invsearch.jpg",
  "environment": "*",
  "entrypoints": {
    "main": ["tempeststudios.inventorysort.InventorySearchServer"],
    "client": ["tempeststudios.inventorysort.InventorySearchClient"]
  },
  "mixins": ["inventorysearch.mixins.json"],
  "depends": {
    "inventorysort_core": ">=${version}",
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}"
  }
}
