{
  "schemaVersion": 1,
  "id": "inventorysort",
  "version": "${version}",
  "name": "Inventory Sort",
  "description": "Client-side inventory sorting and auto-stacking for chests",
  "authors": ["Tempest Studios"],
  "contact": {},
  "license": "LGPL-3.0-only",
  "icon": "assets/inventory-sort/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "tempeststudios.inventorysort.InventorySortCoreClient",
      "tempeststudios.inventorysort.InventorySortClient",
      "tempeststudios.inventorysort.InventorySearchClient",
      "tempeststudios.inventorysort.InventoryCatalogueClient"
    ]
  },
  "mixins": ["inventorysort.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}"
  }
}
